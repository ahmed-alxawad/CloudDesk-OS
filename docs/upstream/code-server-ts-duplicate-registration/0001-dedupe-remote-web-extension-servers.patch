Description: Dedupe identical builtins reported by both the remote and
 web extension management servers, preventing a false "already
 registered" collision the first time Workspace Trust is granted
 (updateExtensionsEnablementsWhenWorkspaceTrustChanges re-evaluates the
 full extension list and emits both the remote and web copies of a
 dual-capable builtin, e.g. vscode.typescript-language-features,
 together in one deltaExtensions call).
Author: CloudDesk-OS engineering
Origin: downstream, https://github.com/microsoft/vscode (no upstream
 fix exists as of 2026-08-27; confirmed identical unpatched logic on
 `main`)
Bug: docs/upstream/code-server-ts-duplicate-registration/README.md
Forwarded: not-yet (draft issue, not filed -- see README.md)
Applies-to: lib/vscode (VS Code commit a5b500951314efd502d07465bd138dfbd714a960, code-server 4.133.0)
Last-Update: 2026-08-27

--- a/lib/vscode/src/vs/workbench/services/extensionManagement/common/extensionManagementService.ts
+++ b/lib/vscode/src/vs/workbench/services/extensionManagement/common/extensionManagementService.ts
@@ -196,7 +196,46 @@
 			}
 			result.push(...installed);
 		}));
-		return result;
+		return this.dedupeBuiltinsAcrossRemoteAndWeb(result);
+	}
+
+	/**
+	 * code-server always configures both a remote extension management
+	 * server (it is always a real remote host) and a web extension
+	 * management server (it always serves VS Code Web's static
+	 * web-extension assets from the same origin) -- a combination
+	 * upstream's more common deployment shapes (pure remote XOR pure
+	 * web) rarely exercise together. A builtin extension that ships
+	 * both a `main` (remote-capable) and a `browser` (web-worker
+	 * capable) entry point -- e.g. vscode.typescript-language-features
+	 * -- is therefore correctly, independently reported as "installed"
+	 * by BOTH servers. The web representation exists specifically to
+	 * cover "no remote connection is available", which is never true
+	 * when a remote server is configured at all, so prefer the remote
+	 * copy and drop the web duplicate for the SAME identifier+version.
+	 * Only touches isBuiltin extensions with a version match, so a
+	 * genuinely different user-installed extension (or a differing
+	 * version on each server, however unlikely) is left untouched.
+	 */
+	private dedupeBuiltinsAcrossRemoteAndWeb(extensions: ILocalExtension[]): ILocalExtension[] {
+		const remoteServer = this.extensionManagementServerService.remoteExtensionManagementServer;
+		const webServer = this.extensionManagementServerService.webExtensionManagementServer;
+		if (!remoteServer || !webServer) {
+			return extensions;
+		}
+		const remoteBuiltins = new Map<string, string>();
+		for (const extension of extensions) {
+			if (extension.isBuiltin && this.extensionManagementServerService.getExtensionManagementServer(extension) === remoteServer) {
+				remoteBuiltins.set(extension.identifier.id.toLowerCase(), extension.manifest.version);
+			}
+		}
+		return extensions.filter(extension => {
+			if (!extension.isBuiltin || this.extensionManagementServerService.getExtensionManagementServer(extension) !== webServer) {
+				return true;
+			}
+			const remoteVersion = remoteBuiltins.get(extension.identifier.id.toLowerCase());
+			return remoteVersion === undefined || remoteVersion !== extension.manifest.version;
+		});
 	}
 
